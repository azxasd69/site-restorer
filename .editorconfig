root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,md,yml,yaml}]
end_of_line = lf
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4

[*.{png,ico}]
insert_final_newline = false
